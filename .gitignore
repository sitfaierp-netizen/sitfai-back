# Variables de entorno y secretos
.env
.env.local
.env.production
creds.json
user.json

# Maven
**/target/
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/release.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE — IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
/out/

# IDE — VS Code
.vscode/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker volumes data
docker/mysql/data/

# Compiled class files
*.class

# Test coverage reports
**/jacoco/
**/surefire-reports/

# Temp files
*.tmp
*.bak
